NEXT_PUBLIC_ADMIN_ID=admin_id_here
NEXT_PUBLIC_SUPABASE_URL=supa_url_here
SUPABASE_SERVICE_ROLE_KEY: service_role_key_here
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=clerk_publishable_key_here
CLERK_SECRET_KEY=clerk_secret_key_here
OPENROUTER_API_KEY=openrouter_key_here

UPLOAD_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_WINDOW_MS=60
SUPABASE_BUCKET_PENDING_IMAGES=pending_images
SUPABASE_BUCKET_APPROVED_IMAGES=approved_images
NEXT_PUBLIC_BYPASS_CLERK=true   // put true or false for testing endpoints without auth protection (for curl, postmanm etc,)
NODE_ENV=development